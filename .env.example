# Sud tizimi — environment example (copy to .env and adjust)
# The app runs fine with ONLY the Cloudflare worker list set; everything
# else has sane defaults.

# ---- Cloudflare workers (the CORS proxy pool) -----------------------------
# Comma-separated worker origins. Also manageable at runtime via
# Sozlamalar > Workerlar (workers.json takes precedence).
CF_WORKER_URLS=https://your-worker-1.workers.dev,https://your-worker-2.workers.dev
# Single-worker fallback (used when CF_WORKER_URLS is unset)
# CF_WORKER_URL=https://your-worker-1.workers.dev

# ---- Worker firing scheduler (v206) — sane defaults, tune freely ----------
# Global in-flight cap (interactive lane)
NET_GLOBAL_MAX=8
# Global in-flight cap for background work (jadval2 scans, exports)
NET_BACKGROUND_MAX=3
# Per-worker in-flight cap
NET_PER_WORKER_MAX=2
# Per-origin (per target host) in-flight cap
NET_PER_ORIGIN_MAX=4
# Minimum spacing between launches at the same origin (ms)
NET_ORIGIN_SPACING_MS=120
# A worker is declared dead after this many consecutive failures
NET_DEAD_THRESHOLD=3
# ...and rests for this long before being retried (ms)
NET_DEAD_COOLDOWN_MS=30000
# Set to 1 to trace every scheduler attempt (pick/hedge/abort) to the log
NET_DEBUG=

# ---- jadval.sud.uz resilience (v207) --------------------------------------
# Optional: pin the direct-curl fallback to the sibling machine serving the
# same app (A record 45.150.25.203, sibling 94.158.54.73).
# JADVAL_RESOLVE_IP=94.158.54.73

# ---- Captcha math solver (VLM) --------------------------------------------
# billing.sud.uz sometimes answers the captcha with a math IMAGE; a vision model
# reads it. Set BOTH values to enable it. Without them the solver looks for a
# `.z-ai-config` file (project dir, your home dir or /etc) — none is shipped,
# because the old one held a committed secret. Restart the server after changing.
# VLM_API_KEY=
# VLM_BASE_URL=
# Only if your z.ai deployment needs the extra X-Token header:
# VLM_TOKEN=

# ---- Auth (optional) ------------------------------------------------------
# Set to require a Bearer token on /api/* from the client.
# NEXT_PUBLIC_APP_API_TOKEN=


# --- Public court-order library (case drawer, Kuzatuv) ---------------------------
# Called DIRECTLY from this machine by default (a public, anonymous API; only your IP is visible to it).
# PUBLIC_ORDERS_VIA_WORKERS=1 routes through your Cloudflare workers instead (redeploy cloudflare-worker/proxy.js).
# The local cache lives in ~/.sud-tizimi/public-orders (outside the project) and is never deleted by the app:
# rebuilding it takes ~10 s per case. Set PUBLIC_ORDERS_DIR to move it (e.g. another drive).
# PUBLIC_ORDERS_VIA_WORKERS=1
# PUBLIC_ORDERS_API=https://adolatapi1.sud.uz
# PUBLIC_ORDERS_DIR=

# --- orginfo.uz ---------------------------------------------------------------------------
# A failed worker attempt is retried DIRECT from this machine (the shared worker's JSON/CORS headers can make orginfo
# answer HTTP 500). Set to 0 to keep orginfo strictly behind the workers.
# ORGINFO_DIRECT_FALLBACK=0

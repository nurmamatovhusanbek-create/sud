# ─────────────────────────────────────────────────────────────────────────────
# Sud Signal — environment template (P0). Copy to .env and fill in.
# No secret literals live in source; everything is read through
# src/server/config.ts (+ src/lib/net/worker-fetch.ts for the NET_* knobs).
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---
# Bearer token required by the app's own API routes in production.
# Empty in development = open (dev convenience only).
APP_API_TOKEN=
# Shown in the UI footer (falls back to "dev").
APP_GIT_SHA=
LOG_LEVEL=info

# --- CF Worker proxy pool (blueprint §3.2 — operator-owned, no strangers) ---
# Comma-separated list. Takes precedence: workers.json → CF_WORKER_URLS →
# CF_WORKER_URL → 4 DEFAULT_WORKERS (src/lib/worker-defaults.ts).
CF_WORKER_URLS=
CF_WORKER_URL=
# Shared secret the app sends and proxy.js checks (harden the worker to require it).
CF_WORKER_SECRET=
CF_WORKER_REQUIRE_CONFIGURED=true

# --- Worker firing scheduler (v206 rate-limit fix — src/lib/net/worker-fetch.ts) ---
# Total in-flight interactive worker requests across ALL jobs.
NET_GLOBAL_MAX=8
# Total in-flight background-lane requests (jadval2 scans) — yields to interactive.
NET_BACKGROUND_MAX=3
# In-flight cap per worker URL.
NET_PER_WORKER_MAX=2
# In-flight cap per origin host (jadvalapi / jadval / chamber / billing).
NET_PER_ORIGIN_MAX=4
# Minimum gap (ms) between two requests to the same origin.
NET_ORIGIN_SPACING_MS=120
# A worker that fails this many times in a row cools down…
NET_DEAD_THRESHOLD=3
# …for this long (ms) before the scheduler tries it again.
NET_DEAD_COOLDOWN_MS=30000
# Tune NET_PER_ORIGIN_MAX / NET_ORIGIN_SPACING_MS first if origins still throttle.

# --- Resilience (P0) ---
# Legacy 3-tier retry ladder (only used where a lib kept its own ladder).
RETRY_TIERS_MS=10000,15000,20000
WORKER_DEAD_THRESHOLD=3
WORKER_DEAD_COOLDOWN_MS=45000
DEFAULT_TIMEOUT_MS=20000

# --- Rate limit (per IP, expensive scrape endpoints) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Cache ---
CACHE_BACKEND=memory
CACHE_KV_URL=
CACHE_TTL_STATS_MS=60000
CACHE_TTL_COURT_MS=60000
CACHE_TTL_COMPANY_MS=1440000
CACHE_TTL_UPCOMING_MS=300000
CACHE_TTL_MIB_SESSION_MS=600000

# --- Captcha / VLM solver (billing math-captcha fallback) ---
VLM_API_KEY=
VLM_BASE_URL=

# --- Side-processes ---
TOR_ENABLED=true
TOR_SOCKS_PORT=9050
IHAMKOR_ENABLED=true
IHAMKOR_PORT=3030

# --- Product knobs ---
ALERT_WINDOW_DAYS=7

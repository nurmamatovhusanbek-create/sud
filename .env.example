# ============================================================================
# Sud Billing Lookup — environment configuration
# Copy to `.env` and fill in. All values are read through src/server/config.ts.
# Nothing operationally meaningful should be hardcoded in source anymore.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
# NODE_ENV=production          # set by the host; do not commit
APP_GIT_SHA=                   # optional; injected by CI for the version display
LOG_LEVEL=info                 # debug | info | warn | error

# --- App API auth (blueprint §3.7) -------------------------------------------
# The client must send this bearer token; middleware rejects mismatches.
# REQUIRED in production — without it, expensive scrape endpoints are open.
APP_API_TOKEN=

# --- Per-IP rate limit for scrape endpoints (blueprint §5.4) -----------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Cloudflare Worker proxy pool (blueprint §3.2) ---------------------------
# Your OWN workers only — comma-separated. No third-party fallbacks ship anymore.
CF_WORKER_URLS=
# Single-worker back-compat (optional):
# CF_WORKER_URL=
# Shared secret the app sends and proxy.js must check (harden the worker to require it).
CF_WORKER_SECRET=
# Fail fast in prod if no workers are configured (recommended true).
CF_WORKER_REQUIRE_CONFIGURED=true

# --- Resilience (were hardcoded in the scrapers) -----------------------------
RETRY_TIERS_MS=10000,15000,20000
WORKER_DEAD_THRESHOLD=3
WORKER_DEAD_COOLDOWN_MS=45000
DEFAULT_TIMEOUT_MS=20000

# --- Cache (blueprint §4.5): 'memory' for single-node, 'kv' for multi-node ----
CACHE_BACKEND=memory
# CACHE_KV_URL=redis://...     # required when CACHE_BACKEND=kv
CACHE_TTL_STATS_MS=60000
CACHE_TTL_COURT_MS=60000
CACHE_TTL_COMPANY_MS=86400000
CACHE_TTL_UPCOMING_MS=300000
CACHE_TTL_MIB_SESSION_MS=600000

# --- Captcha / VLM solver (blueprint §3.7) -----------------------------------
# This was previously a COMMITTED credential in .z-ai-config. Rotate it, then set here.
VLM_API_KEY=
VLM_BASE_URL=

# --- Side-processes (blueprint §2) -------------------------------------------
TOR_ENABLED=true
TOR_SOCKS_PORT=9050
IHAMKOR_ENABLED=true
IHAMKOR_PORT=3030

# --- Product ------------------------------------------------------------------
ALERT_WINDOW_DAYS=7            # "hearings due soon" window for watchlist alerts

# --- Docket index (v205 §5: name-based case discovery) -------------------------
# OPTIONAL. Postgres powers the docket index that discovers cases where the
# company appears by NAME only (no TIN attached). When unset, everything
# degrades gracefully: live TIN search works, name discovery is skipped.
# Setup: psql "$DATABASE_URL" -f migrations/001_docket.sql
DATABASE_URL=
# Run the in-process crawler on THIS host (only ONE instance may own the crawl;
# never on serverless). The crawl window is today -> +35 days (the vka endpoint
# rejects past dates — verified live 2026-09).
CRAWLER_ENABLED=false
CRAWLER_SWEEP_MS=21600000      # 6h between full sweeps
CRAWLER_FUTURE_DAYS=35         # upcoming window per sweep

# NOTE (v205): the P0 note about DATABASE_URL being gone no longer applies —
# Postgres is reintroduced for the docket index ONLY (no Prisma), and it is
# entirely optional.

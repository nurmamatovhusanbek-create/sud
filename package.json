{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.3.8",
  "private": true,
  "scripts": {
    "dev": "node scripts/supervisor.mjs dev",
    "dev:once": "next dev -p 3000 -H 127.0.0.1 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "node scripts/supervisor.mjs start",
    "start:once": "NODE_ENV=production HOSTNAME=127.0.0.1 bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/core src/lib src/server",
    "map": "node scripts/gen-map.mjs",
    "map:check": "node scripts/gen-map.mjs --check",
    "audit": "bun audit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "docx-preview": "^0.4.1",
    "lucide-react": "^0.525.0",
    "next": "^16.3.7",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socks-proxy-agent": "^8.0.5",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "baseline-browser-mapping": "^2.11.0"
  }
}
